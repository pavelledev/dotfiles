{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "modules": [
    {
      "type": "custom",
      "format": "┌──────────────────────────────────────────┐"
    },
    {
      "type": "os",
      "key": "OS",
      "keyColor": "blue"
    },
    {
      "type": "packages",
      "key": "Packages",
      "keyColor": "blue"
    },
    {
      "type": "wm",
      "key": "WM",
      "format": "{1}",
      "keyColor": "blue"
    },
    {
      "type": "shell",
      "key": "Shell",
      "keyColor": "blue"
    },
    {
      "type": "custom",
      "format": "├──────────────────────────────────────────┤"
    },
    {
      "type": "cpu",
      "key": "CPU",
      "format": "{1} @ {7}",
      "keyColor": "blue"
    },
    {
      "type": "gpu",
      "key": "GPU",
      "format": "{1} {2}",
      "keyColor": "blue"
    },
    {
      "type": "memory",
      "key": "Memory",
      "format": "{1} / {2}",
      "keyColor": "blue"
    },
    {
      "type": "display",
      "key": "Display",
      "format": "{1}x{2} @ {3}Hz",
      "keyColor": "blue"
    },
    {
      "type": "uptime",
      "key": "Uptime",
      "keyColor": "blue"
    },
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────┘"
    }
  ]
}
